{
  "expo": {
    "name": "SpanishLearn",
    "slug": "spanish-learn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hatimbenayad.spanishlearn"
    },
    "android": {
      "package": "com.hatimbenayad.spanishlearn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F0E7"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E7",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
